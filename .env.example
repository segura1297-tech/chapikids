# Copia este archivo como  .env  y rellena los valores.
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
#
# El archivo .env NUNCA se sube a git. Este si.
# ---------------------------------------------------------


# ---------- OBLIGATORIO ----------

# Llave secreta de Django. Sin valor por omision a proposito: si falta,
# Django se detiene en vez de arrancar con una llave que cualquiera
# puede conocer.
# Para generar una:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Numero de WhatsApp del negocio, formato internacional, solo digitos.
# Ejemplo Mexico: 5215512345678  (52 lada, 1 movil, 10 digitos)
# Es a donde llegan las cotizaciones.
WHATSAPP_NUMBER=


# ---------- OPCIONAL: modo local ----------

# True = desarrollo. NUNCA True en produccion.
DEBUG=True

# Dominios que pueden servir esta web, separados por coma.
# Local: *    Produccion: midominio.com
ALLOWED_HOSTS=*

# Orígenes permitidos para formularios. Vacio en local.
CSRF_TRUSTED_ORIGINS=


# ---------- OPCIONAL: produccion ----------

# PostgreSQL en Railway. Vacio = se usa el SQLite local (db.sqlite3).
DATABASE_URL=

# Las imagenes se guardan en media/ mientras estas vacias.
# Con credenciales de Cloudflare R2, se suben a la nube.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=